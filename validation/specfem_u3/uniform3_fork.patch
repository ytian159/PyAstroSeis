diff --git a/src/shared/model_prem.f90 b/src/shared/model_prem.f90
index eebc7b1..d11c056 100644
--- a/src/shared/model_prem.f90
+++ b/src/shared/model_prem.f90
@@ -368,6 +368,95 @@
 
   end subroutine model_prem_iso
 
+!
+!=====================================================================
+!
+
+  subroutine model_uniform3(x,rho,drhodr,vp,vs,Qkappa,Qmu,idoubling,CRUSTAL,check_doubling_flag)
+
+! constant-property 3-region benchmark model at PREM radii
+! (pyastroseis corefluid_q50 arbitration model):
+!   inner core   r <= RICB : rho 6.0 g/cc, vp 7.0 km/s, vs 3.5 km/s, Qmu 50
+!   outer core   RICB-RCMB : rho 5.0,      vp 5.5,      fluid, elastic
+!   mantle+crust RCMB-R    : rho 3.0,      vp 6.0,      vs 3.0,      Qmu 50
+! same interface as model_prem_iso; doubling-flag checks kept identical
+
+  use constants
+  use shared_parameters, only: R_PLANET,RHOAV
+
+  use model_prem_par
+
+  implicit none
+
+  double precision,intent(in) :: x
+  double precision,intent(inout) :: rho,drhodr,vp,vs,Qkappa,Qmu
+
+  logical,intent(in) :: CRUSTAL,check_doubling_flag
+  integer,intent(in) :: idoubling
+
+  ! local parameters
+  double precision :: r,scaleval
+
+! compute real physical radius in meters
+  r = x * R_PLANET
+
+  if (check_doubling_flag) then
+    if (r >= 0.d0 .and. r < PREM_RICB) then
+      if (idoubling /= IFLAG_INNER_CORE_NORMAL .and. &
+         idoubling /= IFLAG_MIDDLE_CENTRAL_CUBE .and. &
+         idoubling /= IFLAG_BOTTOM_CENTRAL_CUBE .and. &
+         idoubling /= IFLAG_TOP_CENTRAL_CUBE .and. &
+         idoubling /= IFLAG_IN_FICTITIOUS_CUBE) &
+           stop 'wrong doubling flag for inner core point in model_uniform3()'
+    else if (r > PREM_RICB .and. r < PREM_RCMB) then
+      if (idoubling /= IFLAG_OUTER_CORE_NORMAL) &
+        stop 'wrong doubling flag for outer core point in model_uniform3()'
+    else if (r > PREM_RCMB .and. r < PREM_RTOPDDOUBLEPRIME) then
+      if (idoubling /= IFLAG_MANTLE_NORMAL) &
+        stop 'wrong doubling flag for D" point in model_uniform3()'
+    else if (r > PREM_RTOPDDOUBLEPRIME .and. r < PREM_R670) then
+      if (idoubling /= IFLAG_MANTLE_NORMAL) &
+        stop 'wrong doubling flag for top D" to d670 point in model_uniform3()'
+    else if (r > PREM_R670 .and. r < PREM_R220) then
+      if (idoubling /= IFLAG_670_220) &
+        stop 'wrong doubling flag for d670 to d220 point in model_uniform3()'
+    else if (r > PREM_R220) then
+      if (idoubling /= IFLAG_220_80 .and. idoubling /= IFLAG_80_MOHO .and. idoubling /= IFLAG_CRUST) &
+        stop 'wrong doubling flag for d220 to Moho to surface point in model_uniform3()'
+    endif
+  endif
+
+! constant properties per region (rho in g/cm3, vp/vs in km/s)
+  drhodr = 0.d0
+  if (r >= 0.d0 .and. r <= PREM_RICB) then
+    rho = 6.0d0
+    vp = 7.0d0
+    vs = 3.5d0
+    Qmu = 50.0d0
+    Qkappa = 1.0d8
+  else if (r > PREM_RICB .and. r <= PREM_RCMB) then
+    rho = 5.0d0
+    vp = 5.5d0
+    vs = 0.0d0
+    Qmu = 0.0d0
+    Qkappa = 1.0d8
+  else
+    rho = 3.0d0
+    vp = 6.0d0
+    vs = 3.0d0
+    Qmu = 50.0d0
+    Qkappa = 1.0d8
+  endif
+
+! non-dimensionalize
+  scaleval = dsqrt(PI*GRAV*RHOAV)
+  drhodr = drhodr * 1000.0d0/RHOAV
+  rho = rho * 1000.0d0/RHOAV
+  vp = vp * 1000.0d0/(R_PLANET*scaleval)
+  vs = vs * 1000.0d0/(R_PLANET*scaleval)
+
+  end subroutine model_uniform3
+
 !
 !=====================================================================
 !
